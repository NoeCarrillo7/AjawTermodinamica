---
---

<nav id="main-nav" class="fixed top-0 py-6 md:pt-10 z-50 w-full transition-colors duration-300">
    <div class="w-11/12 md:w-7/8 flex mx-auto justify-between items-center">
        <!-- Logo -->
        <div class="w-auto">
            <img 
                id="nav-logo"
                src="/img/icon.png" 
                alt="Logo Ajaw Termodinamica"
                class="w-12 md:w-15 transition-opacity duration-300"
                loading="eager" 
            />
        </div>

        <!-- Menú Desktop -->
        <div id="nav-links" class="hidden md:flex text-white justify-end items-center gap-10 lg:gap-15 transition-colors duration-300">
            <a href="#inicio" class="nav-link">Inicio</a>
            <a href="#nosotros" class="nav-link">Nosotros</a>
            <a href="#servicios" class="nav-link">Servicios</a>
            <a href="#contacto" class="nav-link">Contacto</a>
        </div>

        <!-- Botón Menú Hamburguesa (Móvil) -->
        <button 
            id="menu-btn" 
            aria-label="Abrir menú" 
            class="md:hidden text-white focus:outline-none z-50 transition-colors duration-300"
        >
            <svg id="menu-icon-open" class="w-8 h-8 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="menu-icon-close" class="w-8 h-8 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <!-- Menú Desplegable Móvil -->
    <div 
        id="mobile-menu" 
        class="hidden md:hidden fixed inset-0 top-0 left-0 w-full h-screen bg-slate-950/95 backdrop-blur-md flex flex-col justify-center items-center gap-8 text-white text-xl font-medium z-40 transition-all duration-300"
    >
        <a href="#inicio" class="mobile-nav-link nav-link">Inicio</a>
        <a href="#nosotros" class="mobile-nav-link nav-link">Nosotros</a>
        <a href="#servicios" class="mobile-nav-link nav-link">Servicios</a>
        <a href="#contacto" class="mobile-nav-link nav-link">Contacto</a>
    </div>
</nav>

<style>
    .nav-link {
        position: relative;
        padding-bottom: 6px;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0%;
        height: 2px;
        background-color: currentColor; 
        transition: width 0.3s ease-in-out;
    }

    .nav-link.active::after {
        width: 100%;
    }
</style>

<script>
    const navLogo = document.getElementById('nav-logo') as HTMLImageElement;
    const navLinksContainer = document.getElementById('nav-links');
    const menuBtn = document.getElementById('menu-btn');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');
    const sections = document.querySelectorAll('[data-theme]');

    const logoBlanco = '/img/icon.png';
    const logoNegro = '/img/icon-azul.png';

    let isMenuOpen = false;

    // Toggle para desplegar / cerrar menú móvil
    function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        if (isMenuOpen) {
            mobileMenu?.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
            menuIconOpen?.classList.add('hidden');
            menuIconOpen?.classList.remove('block');
            menuIconClose?.classList.remove('hidden');
            menuIconClose?.classList.add('block');
        } else {
            mobileMenu?.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
            menuIconOpen?.classList.remove('hidden');
            menuIconOpen?.classList.add('block');
            menuIconClose?.classList.add('hidden');
            menuIconClose?.classList.remove('block');
        }
    }

    menuBtn?.addEventListener('click', toggleMenu);

    // Cerrar menú móvil automáticamente al pulsar una sección
    mobileNavLinks.forEach((link) => {
        link.addEventListener('click', () => {
            if (isMenuOpen) toggleMenu();
        });
    });

    const observerOptions = {
        root: null,
        rootMargin: '-20% 0px -70% 0px',
        threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const targetId = entry.target.getAttribute('id');
                const theme = entry.target.getAttribute('data-theme');

                if (theme === 'light') {
                    navLinksContainer?.classList.remove('text-white');
                    navLinksContainer?.classList.add('text-titulos');

                    menuBtn?.classList.remove('text-white');
                    menuBtn?.classList.add('text-titulos');

                    if (navLogo && navLogo.src !== window.location.origin + logoNegro) {
                        navLogo.src = logoNegro;
                    }
                } else {
                    navLinksContainer?.classList.remove('text-titulos');
                    navLinksContainer?.classList.add('text-white');

                    menuBtn?.classList.remove('text-titulos');
                    menuBtn?.classList.add('text-white');

                    if (navLogo && navLogo.src !== window.location.origin + logoBlanco) {
                        navLogo.src = logoBlanco;
                    }
                }

                if (targetId) {
                    allNavLinks.forEach((link) => {
                        if (link.getAttribute('href') === `#${targetId}`) {
                            link.classList.add('active');
                        } else {
                            link.classList.remove('active');
                        }
                    });
                }
            }
        });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
</script>