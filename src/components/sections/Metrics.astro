---
import { Image } from 'astro:assets';
import metrics from '../../assets/metrics.png'
---




<section>
    <Image
        src={metrics}
        alt="Metrics Imagen"
        class="w-full h-auto object-cover"
        loading="eager"
    />

    <div class="w-full absolute top-250 z-10">
        <div class="w-7/8 mx-auto flex justify-between items-center">
            <div class="w-1/4 flex flex-col text-center gap-7">
                <h1 class="text-[#90959C] text-5xl font-medium">24 / 7</h1>
                <p class="text-[#141B40] text-lg tracking-tight font-normal">Atención a emergencias críticas en planta.</p>
                <h1 class="text-[#90959C] text-5xl font-medium">100%</h1>
                <p class="text-[#141B40] text-lg tracking-tight font-normal">Cumplimiento en normativas de seguridad térmica.</p>
                <h1 class="text-[#90959C] text-5xl font-medium">365 <span class="text-3xl">días</span></h1>
                <p class="text-[#141B40] text-lg tracking-tight font-normal">Monitoreo remoto y registro de temperatura continuo.</p>
            </div>
            <div class="w-3/8 flex flex-col text-end items-end">
                <h1 class="text-[#4A516F] text-4xl font-medium tracking-tight">Soluciones integrales <br> de refrigeración</h1>
                <a href="#" class="border border py-2 px-8 text-sm rounded-sm mt-5">CONTACTANOS</a>
            </div>
        </div>
    </div>
</section>