---
import valores from "../../assets/mision/valores.png";
import icongris from "../../assets/mision/icongris.png";
---

<section data-theme="light" class="mt-5 w-full overflow-hidden">
    <!-- Logo derecha -->
    <img
        src={icongris.src}
        alt=""
        class="animar fadeUp pointer-events-none absolute top-1120  right-60 md:right-90 w-50 md:top-860 md:w-100"
    />

    <div class="w-full overflow-hidden">
        <div class="grid grid-cols-1 items-center lg:grid-cols-2">

            <!-- COLUMNA INFORMACIÓN -->
            <div class="mx-auto ml-8 w-7/8 lg:ml-25">
                <h2 class="animar slideLeft mb-20 text-center text-3xl font-medium text-[#005A8D] lg:text-5xl">
                    Nuestro Enfoque
                </h2>

                <div class="relative space-y-15 pl-10 max-md:pl-6 max-md:space-y-10">

                    <!-- Línea -->
                    <div class="animar slideBottom absolute bottom-2 left-3 top-2 w-[2px] bg-black max-md:left-2 max-md:top-4 max-md:w-[1px]"></div>

                    <!-- Misión -->
                    <div class="relative animar slideBottom">
                        <span class="absolute -left-[35px] top-3 md:top-1 h-4 w-4 rounded-full bg-black max-md:-left-[22px] max-md:h-3 max-md:w-3"></span>

                        <h3 class="mt-10 text-3xl sm:text-4xl font-normal tracking-tight text-[#4A516F] max-md:mt-6">
                            Misión
                        </h3>

                        <p class="animar zoom text-sm sm:text-base md:text-lg text-textos">
                            Brindar soluciones en ingeniería térmica y refrigeración industrial que optimicen la
                            eficiencia, seguridad y continuidad operativa de nuestros clientes mediante tecnología y
                            servicio de calidad.
                        </p>
                    </div>

                    <!-- Visión -->
                    <div class="relative animar slideBottom">
                        <span class="absolute -left-[35px] top-3 md:top-1 h-4 w-4 rounded-full bg-black max-md:-left-[22px] max-md:h-3 max-md:w-3"></span>

                        <h3 class="mt-10 text-3xl sm:text-4xl font-normal tracking-tight text-[#4A516F] max-md:mt-6">
                            Visión
                        </h3>

                        <p class="animar zoom text-sm sm:text-base md:text-lg text-textos">
                            Ser un referente en ingeniería térmica y refrigeración industrial, reconocidos por nuestra
                            innovación, calidad y compromiso con la industria.
                        </p>
                    </div>

                    <!-- Valores -->
                    <div class="relative animar slideBottom">
                        <span class="absolute -left-[35px] top-4 md:top-1 h-4 w-4 rounded-full bg-black max-md:-left-[22px] max-md:h-3 max-md:w-3"></span>

                        <h3 class="mt-8 text-3xl sm:text-4xl font-normal tracking-tight text-[#4A516F] max-md:mt-6">
                            Valores
                        </h3>

                        <p class="animar zoom text-sm sm:text-base md:text-lg text-textos">
                            Compromiso, Calidad, Innovación, Integridad, Seguridad.
                        </p>
                    </div>

                </div>
            </div>

            <!-- COLUMNA IMAGEN -->
            <div class="relative mt-20 flex h-full justify-end">
                <img
                    src={valores.src}
                    alt="Ingeniería térmica"
                    class="animar zoomBig w-[100%] max-w-none translate-x-16 object-contain lg:translate-x-24"
                />
            </div>

        </div>
    </div>
</section>
