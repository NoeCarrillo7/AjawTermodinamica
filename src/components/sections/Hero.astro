---
import { Image } from 'astro:assets';
import imagen from '../../assets/hero.png'
---



<section id="inicio"  data-theme="dark">
    <Image
        src={imagen}
        alt="Hero Imagen"
        class="w-full h-auto object-cover mb-74 md:mb-0 "
        loading="eager"
    />

    <div class="w-full absolute top-60 md:top-30 z-10 bg-[#EAF2FD] md:bg-transparent">
        <div class="w-7/8 mx-auto md:py-20 text-center md:text-start">
            <h1 class="animar zoom md:text-white text-titulos md:text-5xl text-2xl font-medium md:font-normal tracking-tight mb-10">Control térmico de precisión para<br> procesos industriales.</h1>
            <p class="animar fadeLeft md:w-3/6 md:text-white text-xs md:text-lg font-light tracking-tight leading-[1.3]">Diseñamos, instalamos y mantenemos sistemas de refrigeración de gran escala. Protegemos la integridad de sus productos y optimizamos el consumo energético de su planta.</p>
            <div class="mt-10 flex gap-5 md:gap-10 flex-col md:flex-row">
                <a href="#servicios" class="animar fadeUp cardHover py-2 px-7 text-white font-extralight text-sm bg-[#486882] rounded-sm">Ver Servicios</a>
                <a href="#contacto" class="animar fadeUp cardHover  py-2 px-7 md:text-white font-extralight text-sm border border rounded-sm">Contacto</a>
            </div>
        </div>
    </div>
</section>