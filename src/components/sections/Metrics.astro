---
import { Image } from 'astro:assets';
import metrics from '../../assets/metricsImage.png'
---




<section data-theme="light">
    <Image
        src={metrics}
        alt="Metrics Imagen"
        class="w-full h-auto object-cover mb-130 md:mb-0"
        loading="eager"
    />

    <div class="w-full absolute top-190 md:top-250 z-10 border border">
        <div class="w-7/8 mx-auto flex flex-col-reverse md:flex-row justify-between items-center">
            <div class="md:w-1/4 flex flex-col text-center gap-3 md:gap-7">
                <h1 class="text-[#90959C] md:text-5xl text-xl font-medium">24 / 7</h1>
                <p class="text-[#141B40] md:text-lg text-xs tracking-tight font-normal">Atención a emergencias críticas en planta.</p>
                <h1 class="text-[#90959C] md:text-5xl text-xl font-medium">100%</h1>
                <p class="text-[#141B40] md:text-lg text-xs tracking-tight font-normal">Cumplimiento en normativas de seguridad térmica.</p>
                <h1 class="text-[#90959C] md:text-5xl text-xl font-medium">365 <span class="md:text-3xl">días</span></h1>
                <p class="text-[#141B40] md:text-lg text-xs tracking-tight font-normal">Monitoreo remoto y registro de temperatura continuo.</p>
            </div>
            <div class="md:w-3/8 flex flex-col text-center items-center mt-10 md:text-end md:items-end">
                <h1 class="text-[#4A516F] md:text-4xl text-2xl font-medium tracking-tight">Soluciones integrales <br> de refrigeración</h1>
                <a href="#" class="border border py-2 px-8 text-sm rounded-sm mt-5 transition hover:bg-[#486882] hover:text-white">CONTACTANOS</a>
            </div>
        </div>
    </div>
</section>