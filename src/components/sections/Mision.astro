---
import valores from "../../assets/mision/valores.png";
import icongris from "../../assets/mision/icongris.png";
---

<section class="w-full overflow-hidden mt-5">
    <!-- Engrane derecha-->
    <img
        src={icongris.src}
        alt=""
        class="animar zoom absolute top-180 md:top-703 right-90 w-30 md:w-100 pointer-events-none"
    />

    <div class="w-full overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 items-center">
            <!-- COLUMNA INFORMACIÓN -->
            <div class="w-7/8 mx-auto ml-8 lg:ml-25">
                <h2
                    class="text-3xl text-center lg:text-6xl font-semibold text-[#005A8D] mb-20"
                >
                    Nuestro Enfoque
                </h2>

                <div class="relative pl-10 space-y-15">
                    <!-- Línea -->
                    <div
                        class="absolute left-3 top-2 bottom-2 w-[2px] bg-black"
                    >
                    </div>

                    <!-- Misión -->
                    <div class="relative">
                        <span
                            class="absolute -left-[35px] top-1 w-4 h-4 rounded-full bg-black"
                        ></span>

                        <h3
                            class="mt-10 text-[#4A516F] text-4xl font-medium tracking-tight"
                        >
                            Misión
                        </h3>

                        <p
                            class="text-[#141B40] text-lg tracking-tight font-light"
                        >
                            Brindar soluciones en ingeniería térmica y
                            refrigeración industrial que optimicen la
                            eficiencia, seguridad y continuidad operativa de
                            nuestros clientes mediante tecnología y servicio de
                            calidad.
                        </p>
                    </div>

                    <!-- Visión -->
                    <div class="relative">
                        <span
                            class="absolute -left-[35px] top-1 w-4 h-4 rounded-full bg-black"
                        ></span>

                        <h3
                            class="mt-10 text-[#4A516F] text-4xl font-medium tracking-tight"
                        >
                            Visión
                        </h3>

                        <p
                            class="text-[#141B40] text-lg tracking-tight font-light"
                        >
                            Ser un referente en ingeniería térmica y
                            refrigeración industrial, reconocidos por nuestra
                            innovación, calidad y compromiso con la industria.
                        </p>
                    </div>

                    <!-- Valores -->
                    <div class="relative">
                        <span
                            class="absolute -left-[35px] top-1 w-4 h-4 rounded-full bg-black"
                        ></span>

                        <h3
                            class="mt-8 text-[#4A516F] text-4xl font-medium tracking-tight"
                        >
                            Valores
                        </h3>

                        <p
                            class="text-[#141B40] text-lg tracking-tight font-light"
                        >
                            Compromiso, Calidad, Innovación, Integridad,
                            Seguridad.
                        </p>
                    </div>
                </div>
            </div>

            <!-- COLUMNA IMAGEN -->
            <div class="relative h-full flex justify-end mt-20">
                <img
                    src={valores.src}
                    alt="Ingeniería térmica"
                    class="w-[100%] max-w-none object-contain translate-x-16 lg:translate-x-24"
                />
            </div>
        </div>
    </div>
</section>
