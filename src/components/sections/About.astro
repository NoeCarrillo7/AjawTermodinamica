---
import { Image } from 'astro:assets';
import imagen from '../../assets/about.png'
import logo from '../../assets/logo.png'

---



<section id="nosotros" data-theme="light" class="relative overflow-hidden">
    <Image
        src={imagen}
        alt="Hero Imagen"
        class="w-full h-[60vh] md:h-[95vh] object-cover"
        loading="eager"
    />

    <div class="absolute inset-0 flex items-center justify-center px-4 py-10 md:items-start md:justify-center md:pt-24 md:px-0 md:py-0">
        <div class="w-7/8 mx-auto text-center md:p-10">
            <div class="md:w-3/5 w-full flex flex-col items-center gap-8">
                <h1 class="text-2xl font-medium tracking-tight text-titulos sm:text-3xl lg:text-5xl">
                    Sobre la Empresa
                </h1>
                <p class="text-xs font-light tracking-tight w-w-3/6 md:full md:text-lg md:text-textos mb-8">
                    Somos especialistas en ingeniería térmica aplicada a procesos industriales y logística de cadena de frío. Colaboramos con la industria agroalimentaria, farmacéutica y manufacturera para garantizar un control de temperatura riguroso, reduciendo paros no programados y cumpliendo con las normativas nacionales e internacionales de seguridad y eficiencia.
                </p>
                <img src={logo.src} alt="Logo" class="w-1/2  md:w-70" />
            </div>
        </div>
    </div>
</section>